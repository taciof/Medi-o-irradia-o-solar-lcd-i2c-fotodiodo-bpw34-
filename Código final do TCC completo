  int segundosAtuais = horaAtual * 3600 + minutoAtual * 60 + segundoAtual;
  int segundosFim = HORA_FIM * 3600 + MINUTO_FIM * 60;
  
  int segundosRestantes = segundosFim - segundosAtuais;
