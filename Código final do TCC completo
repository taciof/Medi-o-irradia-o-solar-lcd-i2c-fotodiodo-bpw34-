bool ehNovoDia() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) return false;
  static int ultimoDia = -1;
  if (timeinfo.tm_mday != ultimoDia) {
    ultimoDia = timeinfo.tm_mday;
    return true;
  }
  return false;
}

bool horarioPermitido() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) return false;
  int hora = timeinfo.tm_hour;
  int minuto = timeinfo.tm_min;
  int segundo = timeinfo.tm_sec;
  int segundosAtuais = hora * 3600 + minuto * 60 + segundo;
  int segundosInicio = HORA_INICIO * 3600 + MINUTO_INICIO * 60;
  int segundosFim = HORA_FIM * 3600 + MINUTO_FIM * 60;
  return (segundosAtuais >= segundosInicio && segundosAtuais <= segundosFim);
}

bool horarioFinalizado() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) return false;
  int hora = timeinfo.tm_hour;
  int minuto = timeinfo.tm_min;
  return (hora > HORA_FIM || (hora == HORA_FIM && minuto >= MINUTO_FIM));
}

void calcularIntervalo() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) {
    intervaloMin = 30;
    return;
  }
  
  int horaAtual = timeinfo.tm_hour;
  int minutoAtual = timeinfo.tm_min;
  int segundoAtual = timeinfo.tm_sec;
  int segundosAtuais = horaAtual * 3600 + minutoAtual * 60 + segundoAtual;
  int segundosInicio = HORA_INICIO * 3600 + MINUTO_INICIO * 60;
  int segundosFim = HORA_FIM * 3600 + MINUTO_FIM * 60;
  
  int segundosRestantes = segundosFim - segundosAtuais;
  float minutosRestantes = segundosRestantes / 60.0;
  
  int leiturasRestantes = NUM_LEITURAS - contador;
  if (leiturasRestantes > 0) {
    intervaloMin = minutosRestantes / leiturasRestantes;
  } else {
    intervaloMin = 0;
  }
}

