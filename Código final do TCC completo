// ========== CONEXAO WI-FI ==========
void conectarWiFiRapido() {
  if (WiFi.status() == WL_CONNECTED) {
    wifiConectado = true;
    return;
  }
  
  lcd.clear();
  lcd.print("Procurando WiFi");
  
  Serial.println("Escaneando redes...");
  int n = WiFi.scanNetworks();
  if (n == 0) {
    lcd.setCursor(0, 1);
    lcd.print("Nenhuma rede");
    wifiConectado = false;
    return;
  }
  
  String melhorRede = "";
  String melhorSenha = "";
  int melhorForca = -1000;
  
  for (int i = 0; i < n; i++) {
    String ssidScan = WiFi.SSID(i);
    int forca = WiFi.RSSI(i);
    
    for (int j = 0; j < totalRedes; j++) {
      if (ssidScan == redes[j].ssid) {
        if (forca > melhorForca) {
          melhorForca = forca;
          melhorRede = redes[j].ssid;
          melhorSenha = redes[j].senha;
        }
      }
    }
  }
  
  if (melhorRede != "") {
    lcd.clear();
    lcd.print("Conectando:");
    lcd.setCursor(0, 1);
    lcd.print(melhorRede);
    
    WiFi.begin(melhorRede.c_str(), melhorSenha.c_str());
    
    unsigned long inicio = millis();
    while (WiFi.status() != WL_CONNECTED && (millis() - inicio) < 10000) {
      delay(500);
      Serial.print(".");
    }
    
    if (WiFi.status() == WL_CONNECTED) {
      wifiConectado = true;
      lcd.clear();
      lcd.print("WiFi Conectado!");
      Serial.println("WiFi Conectado!");
      sincronizarHora();
    } else {
      wifiConectado = false;
      lcd.clear();
      lcd.print("Timeout WiFi");
    }
  } else {
    wifiConectado = false;
    lcd.clear();
    lcd.print("Rede nao");
    lcd.setCursor(0, 1);
    lcd.print("encontrada");
  }
}

