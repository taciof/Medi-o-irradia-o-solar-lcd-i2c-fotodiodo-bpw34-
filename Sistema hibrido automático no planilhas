// ========== SISTEMA DE HORÁRIO OFFLINE ==========
bool ehNovoDia() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) {
    static unsigned long ultimoReset = 0;
    if (millis() - ultimoReset > 86400000) {
      ultimoReset = millis();
      inicioDiaMillis = 0;
      tempoOfflineCalculado = false;
      Serial.println("=== NOVO DIA OFFLINE ===");
      return true;
    }
    return false;
  }
  
  static int ultimoDia = -1;
  if (timeinfo.tm_mday != ultimoDia) {
    ultimoDia = timeinfo.tm_mday;
    enviouAlerta = false;
    verificouAlerta = false;
    inicioDiaMillis = 0;
    tempoOfflineCalculado = false;
    
    if (dadosPendentes) {
      tentarEnviarDadosPendentes();
    }
    
    Serial.println("=== NOVO DIA ONLINE ===");
    return true;
  }
  return false;
}

bool horarioPermitido() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) {
    if (inicioDiaMillis == 0) {
      inicioDiaMillis = millis();
      Serial.println("Inicio do dia assumido (offline)");
    }
    
    unsigned long tempoDecorrido = millis() - inicioDiaMillis;
    
    return (tempoDecorrido <= PERIODO_DIA_MILLIS);
  }
  
  int hora = timeinfo.tm_hour;
  int minuto = timeinfo.tm_min;
  int segundo = timeinfo.tm_sec;
  int segundosAtuais = hora * 3600 + minuto * 60 + segundo;
  int segundosInicio = HORA_INICIO * 3600 + MINUTO_INICIO * 60;
  int segundosFim = HORA_FIM * 3600 + MINUTO_FIM * 60;
  
  if (segundosFim <= segundosInicio) {
    segundosFim += 24 * 3600;
    if (segundosAtuais < segundosInicio) {
      segundosAtuais += 24 * 3600;
    }
  }
  
  return (segundosAtuais >= segundosInicio && segundosAtuais <= segundosFim);
}

bool horarioFinalizado() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) {
    if (inicioDiaMillis == 0) return false;
    
    unsigned long tempoDecorrido = millis() - inicioDiaMillis;
    
    return (tempoDecorrido >= PERIODO_DIA_MILLIS);
  }
  
  int hora = timeinfo.tm_hour;
  int minuto = timeinfo.tm_min;
  int segundo = timeinfo.tm_sec;
  int segundosAtuais = hora * 3600 + minuto * 60 + segundo;
  int segundosFim = HORA_FIM * 3600 + MINUTO_FIM * 60;
  
  return (hora > HORA_FIM || (hora == HORA_FIM && minuto >= MINUTO_FIM));
}

bool passouDaHoraFinal() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) {
    return false;
  }
  
  int hora = timeinfo.tm_hour;
  int minuto = timeinfo.tm_min;
  
  return (hora >= HORA_FIM && minuto >= MINUTO_FIM);
}

// ========== FUNÇÃO CALCULAR INTERVALO DINÂMICO ==========
void calcularIntervalo() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) {
    if (inicioDiaMillis == 0) {
      intervaloMin = (PERIODO_DIA_MILLIS / 60000.0) / NUM_LEITURAS;
      Serial.printf("OFFLINE - Intervalo inicial: %.1f min\n", intervaloMin);
      return;
    }
    
    unsigned long tempoDecorrido = millis() - inicioDiaMillis;
    
    if (tempoDecorrido >= PERIODO_DIA_MILLIS) {
      intervaloMin = 0;
      Serial.println("OFFLINE - Horario finalizado");
      return;
    }
    
    unsigned long tempoRestanteMillis = PERIODO_DIA_MILLIS - tempoDecorrido;
    float minutosRestantes = tempoRestanteMillis / 60000.0;
    
    int leiturasRestantes = NUM_LEITURAS - contador;
    
    Serial.printf("OFFLINE - Tempo decorrido: %lu min | Restante: %.1f min | Leituras restantes: %d\n", 
                  tempoDecorrido / 60000, minutosRestantes, leiturasRestantes);
    
    if (leiturasRestantes > 0 && minutosRestantes > 0) {
      if (leiturasRestantes == 1) {
        intervaloMin = minutosRestantes;
        Serial.printf("OFFLINE - ULTIMA LEITURA: Intervalo = tempo restante = %.1f min\n", intervaloMin);
      } else {
        intervaloMin = minutosRestantes / leiturasRestantes;
        Serial.printf("OFFLINE - Leituras restantes: %d | Intervalo calculado: %.1f min\n", 
                      leiturasRestantes, intervaloMin);
      }
    } else {
      intervaloMin = 0;
    }
    
    if (intervaloMin < 1.0 && intervaloMin > 0 && leiturasRestantes > 1) {
      intervaloMin = 1.0;
      Serial.println("OFFLINE - Intervalo ajustado para minimo de 1 minuto");
    }
    
    Serial.printf("OFFLINE - Intervalo final: %.1f min\n", intervaloMin);
    return;
  }
  
  int horaAtual = timeinfo.tm_hour;
  int minutoAtual = timeinfo.tm_min;
  int segundoAtual = timeinfo.tm_sec;
  int segundosAtuais = horaAtual * 3600 + minutoAtual * 60 + segundoAtual;
  int segundosInicio = HORA_INICIO * 3600 + MINUTO_INICIO * 60;
  int segundosFim = HORA_FIM * 3600 + MINUTO_FIM * 60;
  
  Serial.printf("ONLINE - Hora atual: %02d:%02d:%02d | Inicio: %02d:%02d | Fim: %02d:%02d\n", 
                horaAtual, minutoAtual, segundoAtual, HORA_INICIO, MINUTO_INICIO, HORA_FIM, MINUTO_FIM);
  
  if (segundosFim <= segundosInicio) {
    segundosFim += 24 * 3600;
    if (segundosAtuais < segundosInicio) {
      segundosAtuais += 24 * 3600;
    }
  }
  
  int segundosRestantes = segundosFim - segundosAtuais;
  float minutosRestantes = segundosRestantes / 60.0;
  
  int leiturasRestantes = NUM_LEITURAS - contador;
  
  Serial.printf("ONLINE - Minutos restantes: %.1f | Leituras restantes: %d\n", 
                minutosRestantes, leiturasRestantes);
  
  if (leiturasRestantes > 0 && minutosRestantes > 0) {
    if (leiturasRestantes == 1) {
      intervaloMin = minutosRestantes;
      Serial.printf("ONLINE - ULTIMA LEITURA: Intervalo = tempo restante = %.1f min\n", intervaloMin);
    } else {
      intervaloMin = minutosRestantes / leiturasRestantes;
      Serial.printf("ONLINE - Leituras restantes: %d | Intervalo calculado: %.1f min\n", 
                    leiturasRestantes, intervaloMin);
    }
  } else {
    intervaloMin = 0;
  }
  
  if (intervaloMin < 1.0 && intervaloMin > 0 && leiturasRestantes > 1) {
    intervaloMin = 1.0;
    Serial.println("ONLINE - Intervalo ajustado para minimo de 1 minuto");
  }
  
  Serial.printf("ONLINE - Intervalo final: %.1f min\n", intervaloMin);
}

