          Blynk.virtualWrite(V0, soma_irradiacao / 10);
          Blynk.virtualWrite(V1, leituras[contador-1]);
          Blynk.virtualWrite(V2, contador);
          Blynk.virtualWrite(V3, (soma_irradiacao / 10) * TEMPO_HORAS_OPERACAO / 1000.0);
