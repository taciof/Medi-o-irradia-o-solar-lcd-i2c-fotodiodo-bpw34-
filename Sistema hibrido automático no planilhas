// ========== FUNÇÃO EXIBIR RELÓGIO OFFLINE ==========
void exibirRelogio() {
  lcd.clear();
  struct tm timeinfo;
  if (getLocalTime(&timeinfo)) {
    lcd.print("Hora: ");
    if (timeinfo.tm_hour < 10) lcd.print("0");
    lcd.print(timeinfo.tm_hour);
    lcd.print(":");
    if (timeinfo.tm_min < 10) lcd.print("0");
    lcd.print(timeinfo.tm_min);
    lcd.print(":");
    if (timeinfo.tm_sec < 10) lcd.print("0");
    lcd.print(timeinfo.tm_sec);
  } else {
    if (inicioDiaMillis == 0) {
      lcd.print("Aguardando inicio");
      lcd.setCursor(0, 1);
      lcd.print("Modo Offline");
    } else {
      unsigned long tempoDecorrido = millis() - inicioDiaMillis;
      unsigned long horas = tempoDecorrido / 3600000;
      unsigned long minutos = (tempoDecorrido % 3600000) / 60000;
      unsigned long segundos = (tempoDecorrido % 60000) / 1000;
      
      lcd.print("Tempo Dia: ");
      if (horas < 10) lcd.print("0");
      lcd.print(horas);
      lcd.print(":");
      if (minutos < 10) lcd.print("0");
      lcd.print(minutos);
      lcd.print(":");
      if (segundos < 10) lcd.print("0");
      lcd.print(segundos);
    }
  }
  
  lcd.setCursor(0, 1);
  switch(estadoAtual) {
    case AGUARDANDO_INICIO: lcd.print("Aguardando "); lcd.print(HORA_INICIO); lcd.print(":00"); break;
    case EXIBINDO_INTERVALO: lcd.print("Preparando..."); break;
    case MEDINDO: lcd.print("Medindo..."); break;
    case EXIBINDO_MEDIA_FINAL: lcd.print("Media Calculada!"); break;
    case EXIBINDO_PAINEIS: lcd.print("Estimativa Paineis"); break;
    case HORARIO_FINALIZADO: lcd.print("Finalizado "); lcd.print(HORA_FIM); lcd.print(":"); if(MINUTO_FIM < 10) lcd.print("0"); lcd.print(MINUTO_FIM); break;
  }
}

