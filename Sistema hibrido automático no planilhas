  lcd.setCursor(0, 1);
  if (getLocalTime(&timeinfo)) {
    int horaAtual = timeinfo.tm_hour;
    int minutoAtual = timeinfo.tm_min;
    int segundoAtual = timeinfo.tm_sec;
    int segundosAtuais = horaAtual * 3600 + minutoAtual * 60 + segundoAtual;
    int segundosInicio = HORA_INICIO * 3600 + MINUTO_INICIO * 60;
    int segundosFim = HORA_FIM * 3600 + MINUTO_FIM * 60;
    
    if (segundosFim <= segundosInicio) {
      segundosFim += 24 * 3600;
      if (segundosAtuais < segundosInicio) {
        segundosAtuais += 24 * 3600;
      }
    }
    
    int segundosRestantes = segundosFim - segundosAtuais;
    float minutosRestantes = segundosRestantes / 60.0;
    
    lcd.print("Total:");
    lcd.print(minutosRestantes, 0);
    lcd.print("min");
  } else {
    lcd.print("Modo Offline");
  }
  
  Serial.printf("Interv: %.0f min | %d leituras | WiFi: %s\n", 
                intervaloMin, contador, wifiConectado ? "SIM" : "NAO");
}

bool enviarLeituraParaPlanilha(float irrad) {
  if (wifiConectado) {
    HTTPClient http;
    http.begin(scriptURL);
    http.addHeader("Content-Type", "application/json");

    struct tm timeinfo;
    char dataStr[12] = "00/00/0000";
    char horaStr[12] = "00:00:00";
    
    if (getLocalTime(&timeinfo)) {
      strftime(dataStr, sizeof(dataStr), "%d/%m/%Y", &timeinfo);
      strftime(horaStr, sizeof(horaStr), "%H:%M:%S", &timeinfo);
    }

    String jsonData = "{";
    jsonData += "\"action\":\"escreverEmLista\",";
    jsonData += "\"data\":\"" + String(dataStr) + "\",";
    jsonData += "\"hora\":\"" + String(horaStr) + "\",";
    jsonData += "\"media\":" + String(irrad, 2) + ",";
    jsonData += "\"energia\":0,";
    jsonData += "\"energia_pequeno\":0,";
    jsonData += "\"energia_medio\":0,";
    jsonData += "\"energia_grande\":0";
    jsonData += "}";

    Serial.println("Enviando leitura para planilha:");
    Serial.println(jsonData);

    int httpCode = http.POST(jsonData);
    if (httpCode > 0) {
      Serial.printf("Leitura enviada: %d\n", httpCode);
      http.end();
      return true;
    } else {
      Serial.printf("Erro ao enviar leitura: %s\n", http.errorToString(httpCode).c_str());
      http.end();
    }
  }
  return false;
}

bool enviarDadosCompletosParaPlanilha(float media, float energia, float energiaPequeno, float energiaMedio, float energiaGrande) {
  if (wifiConectado) {
    HTTPClient http;
    http.begin(scriptURL);
    http.addHeader("Content-Type", "application/json");

    struct tm timeinfo;
    char dataStr[12] = "00/00/0000";
    char horaStr[12] = "00:00:00";
    
    if (getLocalTime(&timeinfo)) {
      strftime(dataStr, sizeof(dataStr), "%d/%m/%Y", &timeinfo);
      strftime(horaStr, sizeof(horaStr), "%H:%M:%S", &timeinfo);
    }

    String jsonData = "{";
    jsonData += "\"action\":\"escreverEmLista\",";
    jsonData += "\"data\":\"" + String(dataStr) + "\",";
    jsonData += "\"hora\":\"" + String(horaStr) + "\",";
    jsonData += "\"media\":" + String(media, 2) + ",";
    jsonData += "\"energia\":" + String(energia, 4) + ",";
    jsonData += "\"energia_pequeno\":" + String(energiaPequeno, 4) + ",";
    jsonData += "\"energia_medio\":" + String(energiaMedio, 4) + ",";
    jsonData += "\"energia_grande\":" + String(energiaGrande, 4);
    jsonData += "}";

    Serial.println("Enviando dados COMPLETOS para planilha:");
    Serial.println(jsonData);

    int httpCode = http.POST(jsonData);
    if (httpCode > 0) {
      Serial.printf("Dados completos enviados: %d\n", httpCode);
      String response = http.getString();
      Serial.println("Resposta: " + response);
      
      lcd.clear();
      lcd.print("Dados completos!");
      lcd.setCursor(0, 1);
      lcd.print("Enviados OK");
      delay(2000);
      return true;
    } else {
      Serial.printf("Erro ao enviar dados completos: %s\n", http.errorToString(httpCode).c_str());
    }
    http.end();
  }
  
  return salvarDadosLocalmente(media, energia, energiaPequeno, energiaMedio, energiaGrande);
}

bool salvarDadosLocalmente(float media, float energia, float energiaPequeno, float energiaMedio, float energiaGrande) {
  struct tm timeinfo;
  if (getLocalTime(&timeinfo)) {
    strftime(dadosAtuais.data, sizeof(dadosAtuais.data), "%d/%m/%Y", &timeinfo);
  } else {
    strcpy(dadosAtuais.data, "00/00/0000");
  }
  
  dadosAtuais.media = media;
  dadosAtuais.energia = energia;
  dadosAtuais.energiaPequeno = energiaPequeno;
  dadosAtuais.energiaMedio = energiaMedio;
  dadosAtuais.energiaGrande = energiaGrande;
  dadosAtuais.enviado = false;
  dadosPendentes = true;
  
  Serial.println("Dados salvos localmente (pendentes)");
  Serial.printf("Data: %s | Media: %.1f W/m2 | Energia: %.4f kWh\n", 
                dadosAtuais.data, media, energia);
  
  lcd.clear();
  lcd.print("Dados salvos");
  lcd.setCursor(0, 1);
  lcd.print("localmente");
  delay(2000);
  
  return true;
}

void tentarEnviarDadosPendentes() {
  if (dadosPendentes && wifiConectado && !dadosAtuais.enviado && tentarEnvioPendentes) {
    lcd.clear();
    lcd.print("Enviando dados");
    lcd.setCursor(0, 1);
    lcd.print("pendentes...");
    
    Serial.println("Tentando enviar dados pendentes para planilha...");
    
    bool sucesso = enviarDadosCompletosParaPlanilha(dadosAtuais.media, dadosAtuais.energia, 
                          dadosAtuais.energiaPequeno, dadosAtuais.energiaMedio, 
                          dadosAtuais.energiaGrande);
    
    if (sucesso) {
      dadosPendentes = false;
      dadosAtuais.enviado = true;
      tentarEnvioPendentes = false;
      Serial.println("Dados pendentes enviados com sucesso!");
      
      lcd.clear();
      lcd.print("Envio concluido!");
      lcd.setCursor(0, 1);
      lcd.print("Voltando...");
      delay(2000);
    } else {
      Serial.println("Falha no envio dos dados pendentes");
      tentarEnvioPendentes = false;
    }
  }
}

float lerFotodiodoMelhorado() {
  int amostras = 15;
  long soma = 0;
  for (int i = 0; i < amostras; i++) {
    soma += analogRead(fotoDiodoPIN);
    delay(10);
  }
  int leituraMedia = soma / amostras;
  float tensao = (leituraMedia / 4095.0) * 3.3;
  float irrad = tensao * fatorCalibracao * 1000.0;
  
  if (irrad < 0) irrad = 0;
  
  return irrad;
}

void exibirEstimativaPaineis(float media) {
  unsigned long tempoAtual = millis();
  
  if (!paineisExibidos) {
    paineisExibidos = true;
    painelAtual = 0;
    tempoExibicaoPainel = tempoAtual;
    Serial.println("Iniciando exibicao dos paineis");
  }
  
  float areaPequeno = 1.0;
  float areaMedio = 2.5;  
  float areaGrande = 5.0;
  
  float energiaPequeno = (media * TEMPO_HORAS_OPERACAO * areaPequeno) / 1000.0;
  float energiaMedio = (media * TEMPO_HORAS_OPERACAO * areaMedio) / 1000.0;
  float energiaGrande = (media * TEMPO_HORAS_OPERACAO * areaGrande) / 1000.0;
  
  if (tempoAtual - tempoExibicaoPainel >= TEMPO_EXIBICAO_PAINEL) {
    painelAtual++;
    tempoExibicaoPainel = tempoAtual;
    
    if (painelAtual > 2) {
      estadoAtual = HORARIO_FINALIZADO;
      paineisExibidos = false;
      Serial.println("Todos os paineis foram exibidos");
      return;
    }
  }
  
  lcd.clear();
  switch(painelAtual) {
    case 0:
      lcd.print("IRRAD:");
      lcd.print(media, 1);
      lcd.print("W/m2");
      lcd.setCursor(0, 1);
      lcd.print("EST.PEQ:");
      lcd.print(energiaPequeno, 3);
      lcd.print("kWh");
      break;
      
    case 1:
      lcd.print("IRRAD:");
      lcd.print(media, 1);
      lcd.print("W/m2");
      lcd.setCursor(0, 1);
      lcd.print("EST.MED:");
      lcd.print(energiaMedio, 3);
      lcd.print("kWh");
      break;
      
    case 2:
      lcd.print("IRRAD:");
      lcd.print(media, 1);
      lcd.print("W/m2");
      lcd.setCursor(0, 1);
      lcd.print("EST.GRA:");
      lcd.print(energiaGrande, 3);
      lcd.print("kWh");
      break;
  }
}

void calcularMediaFinal() {
  Serial.println("=== INICIANDO CALCULO DA MEDIA ===");
  
  if (contador == 0) {
    Serial.println("Nenhuma leitura para calcular media!");
    lcd.clear();
    lcd.print("Sem leituras");
    lcd.setCursor(0, 1);
    lcd.print("para calcular");
    delay(5000);
    return;
  }
  
  float media = soma_irradiacao / 10;
  float energia = (media * TEMPO_HORAS_OPERACAO) / 1000.0;

  float areaPequeno = 1.0;
  float areaMedio = 2.5;  
  float areaGrande = 5.0;
  
  float energiaPequeno = (media * TEMPO_HORAS_OPERACAO * areaPequeno) / 1000.0;
  float energiaMedio = (media * TEMPO_HORAS_OPERACAO * areaMedio) / 1000.0;
  float energiaGrande = (media * TEMPO_HORAS_OPERACAO * areaGrande) / 1000.0;

  estadoAtual = EXIBINDO_MEDIA_FINAL;
  tempoEstadoInicio = millis();
  
  lcd.clear();
  lcd.print("Media:");
  lcd.print(media, 1);
  lcd.print("W/m2");
  lcd.setCursor(0, 1);
  lcd.print("Energia:");
  lcd.print(energia, 4);
  lcd.print("kWh");

  Serial.println("=== MEDIA FINAL CALCULADA ===");
  Serial.printf("Total de leituras: %d\n", contador);
  Serial.printf("SOMA TOTAL de todas leituras: %.1f W/m2\n", soma_irradiacao);
  Serial.printf("MEDIA (Soma ÷ 10): %.1f W/m2\n", media);
  Serial.printf("Tempo: %.2f horas (%d:%02d-%d:%02d)\n", 
                TEMPO_HORAS_OPERACAO, HORA_INICIO, MINUTO_INICIO, HORA_FIM, MINUTO_FIM);
  Serial.printf("Energia gerada: %.4f kWh/m2\n", energia);
  Serial.printf("Painel Pequeno (1m2): %.4f kWh\n", energiaPequeno);
  Serial.printf("Painel Medio (2.5m2): %.4f kWh\n", energiaMedio);
  Serial.printf("Painel Grande (5m2): %.4f kWh\n", energiaGrande);
  Serial.printf("WiFi: %s | Blynk: %s\n", wifiConectado ? "SIM" : "NAO", blynkConectado ? "SIM" : "NAO");
  
  Serial.println("Leituras realizadas:");
  for (int i = 0; i < contador; i++) {
    Serial.printf("Leitura %d: %.1f W/m2\n", i+1, leituras[i]);
  }
  Serial.println("=======================");

  if (wifiConectado && blynkConectado) {
    Blynk.virtualWrite(V0, media);
    Blynk.virtualWrite(V1, 0);
    Blynk.virtualWrite(V2, contador);
    Blynk.virtualWrite(V3, energia);
    Blynk.run();
  }

  enviarDadosCompletosParaPlanilha(media, energia, energiaPequeno, energiaMedio, energiaGrande);
  
  cicloConcluidoHoje = true;
  Serial.println("Media sera exibida por 10 segundos...");
}

void medirIrradiacao() {
  if (estadoAtual != MEDINDO || sistemaPausado) {
    Serial.printf("medirIrradiacao() BLOQUEADA - Estado: %d, Pausado: %d\n", 
                  estadoAtual, sistemaPausado);
    return;
  }
  
  if (horarioFinalizado()) {
    Serial.println("HORARIO FINALIZADO - Calculando media...");
    calcularMediaFinal();
    return;
  }
  
  if (contador >= NUM_LEITURAS) {
    Serial.println("LEITURAS COMPLETAS - Calculando media...");
    calcularMediaFinal();
    return;
  }
  
  Serial.printf("REALIZANDO LEITURA %d...\n", contador + 1);
  float irrad = lerFotodiodoMelhorado();

  if (irrad > 600.0) {
    digitalWrite(ledPin, HIGH);
    Serial.println("LED ACESO - Excelente irradiacao!");
  } else {
    digitalWrite(ledPin, LOW);
  }

  if (contador < NUM_LEITURAS) {
    leituras[contador] = irrad;
    soma_irradiacao += irrad;
    contador++;

    Serial.printf("Leitura %d: %.1f W/m2 | SOMA: %.1f W/m2 | WiFi: %s\n", 
                  contador, irrad, soma_irradiacao, wifiConectado ? "SIM" : "NAO");

    lcd.clear();
    lcd.print("Irrad:");
    lcd.print(irrad, 1);
    lcd.print("W/m2");
    lcd.setCursor(0, 1);
    
    int displayLeitura = (contador > NUM_LEITURAS_DISPLAY) ? NUM_LEITURAS_DISPLAY : contador;
    lcd.print("L:");
    lcd.print(displayLeitura);
    lcd.print("/");
    lcd.print(NUM_LEITURAS_DISPLAY);
    
    lcd.print(" I:");
    lcd.print(intervaloMin, 1);
    lcd.print("m");

    if (wifiConectado) {
      enviarLeituraParaPlanilha(irrad);
    }

    if (wifiConectado && blynkConectado) {
      Blynk.virtualWrite(V1, irrad);
      Blynk.virtualWrite(V2, contador);
      Blynk.run();
    }

    float intervaloAnterior = intervaloMin;
    calcularIntervalo();
    Serial.printf("Intervalo atualizado: %.1f min -> %.1f min\n", 
                  intervaloAnterior, intervaloMin);
    
    if (contador < NUM_LEITURAS) {
      proximaLeitura = millis() + (unsigned long)(intervaloMin * 60000);
      
      Serial.printf("PROXIMA LEITURA: Leitura %d em %.1f minutos\n", 
                    contador + 1, intervaloMin);
      Serial.printf("Tempo restante aproximado: %.1f minutos\n", 
                    intervaloMin * (NUM_LEITURAS - contador));
      
      lcd.clear();
      lcd.print("Prox. em:");
      lcd.print(intervaloMin, 1);
      lcd.print("min");
      lcd.setCursor(0, 1);
      
      int proxDisplayLeitura = (contador + 1 > NUM_LEITURAS_DISPLAY) ? NUM_LEITURAS_DISPLAY : contador + 1;
      lcd.print("Leitura ");
      lcd.print(proxDisplayLeitura);
      lcd.print("/");
      lcd.print(NUM_LEITURAS_DISPLAY);
      delay(3000);
    }
  }
}

void verificarSeguranca() {
  if (passouDaHoraFinal() && !verificouAlerta && cicloConcluidoHoje) {
    verificouAlerta = true;
    
    if (!enviouAlerta && wifiConectado) {
      lcd.clear();
      lcd.print("Enviando alerta");
      lcd.setCursor(0, 1);
      lcd.print("final do dia");
      
      if (enviarDadosCompletosParaPlanilha(0, 0, 0, 0, 0)) {
        enviouAlerta = true;
        Serial.println("Alerta do final do dia enviado!");
      }
    }
  }
}

void testarBotoes() {
  static unsigned long ultimoTeste = 0;
  if (millis() - ultimoTeste > 5000) {
    bool pausa = digitalRead(BOTAO_PAUSA);
    bool reset = digitalRead(BOTAO_RESET_WIFI);
    
    Serial.printf("[DEBUG] Pausa: %d | Reset: %d | Sistema Pausado: %d | WiFi: %s | Blynk: %s\n", 
                  pausa, reset, sistemaPausado, wifiConectado ? "SIM" : "NAO", blynkConectado ? "SIM" : "NAO");
    
    ultimoTeste = millis();
  }
}

void gerenciarEstados() {
  unsigned long tempoAtual = millis();
  
  verificarSeguranca();
  controlarPausa();
  controlarResetWifi();
  testarBotoes();
  
  if (wifiConectado && dadosPendentes && tentarEnvioPendentes) {
    tentarEnviarDadosPendentes();
  }
  
  static unsigned long ultimaTentativaWiFi = 0;
  if (!wifiConectado && tempoAtual - ultimaTentativaWiFi >= 30000) {
    conectarWiFiRapido();
    ultimaTentativaWiFi = tempoAtual;
  }
  
  if (tempoAtual - ultimoResetEnvio >= 3600000) {
    tentouEnviarPendentes = false;
    ultimoResetEnvio = tempoAtual;
  }
  
  if (sistemaPausado) {
    static unsigned long ultimaAtualizacaoPausa = 0;
    if (tempoAtual - ultimaAtualizacaoPausa >= 2000) {
      lcd.clear();
      lcd.print("SISTEMA PAUSADO");
      lcd.setCursor(0, 1);
      
      int displayLeitura = (leituraPausada + 1 > NUM_LEITURAS_DISPLAY) ? NUM_LEITURAS_DISPLAY : leituraPausada + 1;
      lcd.print("Prox.Leitura:");
      lcd.print(displayLeitura);
      ultimaAtualizacaoPausa = tempoAtual;
    }
    return;
  }
  
  static unsigned long ultimoDebugEstado = 0;
  if (tempoAtual - ultimoDebugEstado >= 3000) {
    unsigned long tempoRestante = (proximaLeitura > tempoAtual) ? (proximaLeitura - tempoAtual) : 0;
    Serial.printf("[ESTADO] Estado: %d | Pausado: %d | Leituras: %d/%d | Proxima em: %lu ms (%.1f min)\n", 
                  estadoAtual, sistemaPausado, contador, NUM_LEITURAS, 
                  tempoRestante, tempoRestante / 60000.0);
    ultimoDebugEstado = tempoAtual;
  }
  
  static unsigned long ultimaAtualizacaoLCD = 0;
  if (estadoAtual == MEDINDO && tempoAtual - ultimaAtualizacaoLCD >= 2000) {
    if (contador > 0) {
      lcd.clear();
      lcd.print("Ultima:");
      lcd.print(leituras[contador-1], 1);
      lcd.print("W/m2");
      lcd.setCursor(0, 1);
      
      int displayLeitura = (contador > NUM_LEITURAS_DISPLAY) ? NUM_LEITURAS_DISPLAY : contador;
      lcd.print("L:");
      lcd.print(displayLeitura);
      lcd.print("/");
      lcd.print(NUM_LEITURAS_DISPLAY);
      lcd.print(" I:");
      lcd.print(intervaloMin, 1);
      lcd.print("m");
    }
    ultimaAtualizacaoLCD = tempoAtual;
  }
  
  switch(estadoAtual) {
    case AGUARDANDO_INICIO:
      if (horarioPermitido() && !cicloConcluidoHoje) {
        estadoAtual = EXIBINDO_INTERVALO;
        tempoEstadoInicio = tempoAtual;
        calcularIntervalo();
        exibirIntervaloETotal();
        Serial.println("INICIANDO CICLO - Exibindo intervalo por 10 segundos...");
      }
      break;
      
    case EXIBINDO_INTERVALO:
      if (tempoAtual - tempoEstadoInicio >= TEMPO_EXIBICAO_INTERVALO) {
        estadoAtual = MEDINDO;
        medicaoAtiva = true;
        calcularIntervalo();
        
        proximaLeitura = tempoAtual;
        Serial.println("INICIANDO MEDICOES - Primeira leitura IMEDIATA");
        
        lcd.clear();
        lcd.print("INICIANDO");
        lcd.setCursor(0, 1);
        lcd.print("MEDICOES...");
        delay(1000);
      } else {
        static unsigned long ultimaAtualizacao = 0;
        if (tempoAtual - ultimaAtualizacao >= 5000) {
          exibirIntervaloETotal();
          ultimaAtualizacao = tempoAtual;
        }
      }
      break;
      
    case MEDINDO:
      if (tempoAtual >= proximaLeitura) {
        Serial.println("EXECUTANDO LEITURA...");
        medirIrradiacao();
      }
      
      if (contador >= NUM_LEITURAS || horarioFinalizado()) {
        Serial.println("FINALIZANDO MEDICOES - Calculando media...");
        calcularMediaFinal();
      }
      break;
      
    case EXIBINDO_MEDIA_FINAL:
      if (tempoAtual - tempoEstadoInicio >= TEMPO_EXIBICAO_MEDIA) {
        estadoAtual = EXIBINDO_PAINEIS;
        float media = soma_irradiacao / 10;
        exibirEstimativaPaineis(media);
        Serial.println("INICIANDO EXIBICAO DOS PAINEIS...");
      }
      break;
      
    case EXIBINDO_PAINEIS:
      if (estadoAtual == EXIBINDO_PAINEIS) {
        float media = soma_irradiacao / 10;
        exibirEstimativaPaineis(media);
      }
      break;
      
    case HORARIO_FINALIZADO:
      break;
  }
}

// ========== SETUP E LOOP PRINCIPAIS ==========
void setup() {
  pinMode(fotoDiodoPIN, INPUT);
  pinMode(ledPin, OUTPUT);
  pinMode(BOTAO_PAUSA, INPUT_PULLUP);
  pinMode(BOTAO_RESET_WIFI, INPUT_PULLUP);
  digitalWrite(ledPin, LOW);
  
  Serial.begin(115200);
  Serial.println("=== SISTEMA SOLAR HIBRIDO INICIADO ===");
  Serial.printf("Horario: %d:%02d - %d:%02d (%.2f horas)\n", HORA_INICIO, MINUTO_INICIO, HORA_FIM, MINUTO_FIM, TEMPO_HORAS_OPERACAO);
  Serial.printf("Total de leituras: %d (display mostra ate %d)\n", NUM_LEITURAS, NUM_LEITURAS_DISPLAY);
  
  Serial.printf("Botao Pausa (Pino %d): %s\n", BOTAO_PAUSA, 
                digitalRead(BOTAO_PAUSA) == HIGH ? "SOLTO" : "PRESSIONADO");
  Serial.printf("Botao Reset WiFi (Pino %d): %s\n", BOTAO_RESET_WIFI, 
                digitalRead(BOTAO_RESET_WIFI) == HIGH ? "SOLTO" : "PRESSIONADO");
  
  Wire.begin(21, 22);
  lcd.init();
  lcd.backlight();
  lcd.clear();
  lcd.print("Sistema Hibrido");
  lcd.setCursor(0, 1);
  lcd.print("8:00-16:00");  // ATUALIZADO: 8:00-16:00
  delay(2000);
  
  conectarWiFiRapido();
  
  estadoAtual = AGUARDANDO_INICIO;
}

void loop() {
  if (blynkConectado) {
    Blynk.run();
  }

  if (ehNovoDia()) {
    cicloConcluidoHoje = false;
    contador = 0;
    soma_irradiacao = 0.0;
    paineisExibidos = false;
    sistemaPausado = false;
    tempoPausaAcumulado = 0;
    tempoRestanteLeitura = 0;
    ajustouIntervalos = false;
    enviouAlerta = false;
    verificouAlerta = false;
    tentarEnvioPendentes = false;
    tentouEnviarPendentes = false;
    inicioDiaMillis = 0;
    tempoOfflineCalculado = false;
    estadoAtual = AGUARDANDO_INICIO;
    Serial.println("=== NOVO DIA - SISTEMA RESETADO ===");
  }

  gerenciarEstados();

  static unsigned long ultimaAtualizacaoRelogio = 0;
  if (millis() - ultimaAtualizacaoRelogio >= 1000) {
    if (estadoAtual == AGUARDANDO_INICIO || estadoAtual == HORARIO_FINALIZADO) {
      exibirRelogio();
    }
    ultimaAtualizacaoRelogio = millis();
  }
  
  delay(100);
}

BLYNK_CONNECTED() {
  Serial.println("Blynk conectado!");
  blynkConectado = true;
  Blynk.virtualWrite(V0, 0);
  Blynk.virtualWrite(V1, 0);
  Blynk.virtualWrite(V2, 0);
  Blynk.virtualWrite(V3, 0);
}

BLYNK_DISCONNECTED() {
  Serial.println("Blynk desconectado!");
  blynkConectado = false;
}
